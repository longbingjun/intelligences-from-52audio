---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductBrowser from "../components/ProductBrowser";
import { withBase } from "../lib/paths";
import { researchPriorityRank, type IndexProduct } from "../lib/types";
import fs from "node:fs";
import path from "node:path";

const dataDir = path.join(process.cwd(), "public", "data");
const manifest = JSON.parse(fs.readFileSync(path.join(dataDir, "categories.json"), "utf-8"));
const productIndex = JSON.parse(fs.readFileSync(path.join(dataDir, "products", "index.json"), "utf-8"));
const categories = manifest.categories as { name: string; slug: string; file: string; product_count: number }[];
const allProducts = productIndex.products as IndexProduct[];
const currentYear = String(new Date().getFullYear());
const recentFocusCount = allProducts.filter((product) => researchPriorityRank(product) <= 2).length;
const officialPageCount = allProducts.filter((product) => product.official_page_status === "found").length;

const brandCounts = new Map<string, number>();
let unknownBrandCount = 0;
for (const product of allProducts) {
  const brand = (product.brand || "").trim();
  if (!brand) unknownBrandCount += 1;
  else brandCounts.set(brand, (brandCounts.get(brand) || 0) + 1);
}
const brands = Array.from(brandCounts.entries()).map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-CN"));
const initialSlices = categories.map((category) => ({
  category: category.name,
  products: allProducts.filter((product) => product.category === category.name).sort((a, b) => researchPriorityRank(a) - researchPriorityRank(b) || (b.latest_published || "").localeCompare(a.latest_published || "")).slice(0, 9),
}));

const productsDataDir = path.join(dataDir, "products");
let productPriced = 0;
if (fs.existsSync(productsDataDir)) {
  for (const file of fs.readdirSync(productsDataDir)) {
    if (file === "index.json" || !file.endsWith(".json")) continue;
    try { if (JSON.parse(fs.readFileSync(path.join(productsDataDir, file), "utf-8"))?.cost_snapshot?.price_cny != null) productPriced += 1; } catch { /* ignore a damaged record */ }
  }
}
---

<BaseLayout title="竞品物料分析工作台" activeNav="home">
  <section class="dashboard-hero">
    <div class="dashboard-hero-copy">
      <p class="eyebrow">52AUDIO · 竞品物料分析</p>
      <h1>竞品物料分析<br /><span>工作台</span></h1>
      <p class="dashboard-hero-description">集产品发现、拆解物料、可溯源售价与跨品类对比于一体的研究工作台。</p>
      <div class="hero-actions"><a href="#workspace" class="hero-primary-action">浏览产品 <span>→</span></a><a href={withBase("/compare")} class="hero-secondary-action">打开对比</a></div>
    </div>
    <div class="dashboard-hero-art" aria-hidden="true"><div class="hero-orbit hero-orbit--one"></div><div class="hero-orbit hero-orbit--two"></div><div class="hero-product-glyph"><span></span><i></i><b></b></div><div class="hero-signal hero-signal--one">{officialPageCount} 个官网页面</div><div class="hero-signal hero-signal--two">{currentYear} 年当前数据集</div></div>
  </section>
  <section class="dashboard-kpis" aria-label="研究数据覆盖"><article><span class="kpi-icon kpi-icon--blue">◈</span><div><strong>{manifest.product_count}</strong><span>已收录产品</span></div></article><article><span class="kpi-icon kpi-icon--purple">⌁</span><div><strong>{recentFocusCount}</strong><span>重点研究队列</span></div></article><article><span class="kpi-icon kpi-icon--cyan">¥</span><div><strong>{productPriced}</strong><span>已记录售价产品</span></div></article><article><span class="kpi-icon kpi-icon--orange">◎</span><div><strong>{officialPageCount}</strong><span>官网页面可溯源</span></div></article></section>
  <ProductBrowser client:load categories={categories.map((category) => ({ name: category.name, slug: category.slug, product_count: category.product_count }))} totalCount={manifest.product_count} brands={brands} unknownBrandCount={unknownBrandCount} initialSlices={initialSlices} fullIndexUrl={withBase("/data/products/index.json")} />
</BaseLayout>
