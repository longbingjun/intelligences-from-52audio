---
interface RoundupReport {
  id: string;
  title: string;
  published_at?: string;
  url?: string;
  category?: string;
  author?: string;
  kind?: string;
  summary?: string;
}

interface Props {
  reports: RoundupReport[];
  years?: string[];
}

const { reports, years = [] } = Astro.props;
const featured = reports.slice(0, 4);
---

{featured.length > 0 && (
  <section class="roundup-insights" aria-labelledby="roundup-insights-title">
    <div class="roundup-insights__heading">
      <div>
        <p class="eyebrow">RESEARCH DIGEST</p>
        <h2 id="roundup-insights-title">年度洞察与汇总报告</h2>
        <p>汇总类原始报告单独呈现，不作为单一产品纳入工作台卡片。</p>
      </div>
      <div class="roundup-insights__years" aria-label="覆盖年度">
        {years.slice(0, 4).map((year) => <span>{year}</span>)}
      </div>
    </div>

    <div class="roundup-insights__grid">
      {featured.map((report, index) => (
        <a class:list={["roundup-card", { "roundup-card--featured": index === 0 }]} href={report.url || "#"} target="_blank" rel="noopener noreferrer">
          <div class="roundup-card__meta">
            <span>{report.kind || "汇总报告"}</span>
            <time datetime={report.published_at}>{report.published_at || "日期待补"}</time>
          </div>
          <h3>{report.title}</h3>
          {report.summary && <p>{report.summary}</p>}
          <div class="roundup-card__foot">
            <span>{report.category || "耳机研究"}</span>
            <b>阅读原文 <i>→</i></b>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .roundup-insights { margin-top: 26px; border: 1px solid #e1e7f4; border-radius: 20px; padding: 22px; background: linear-gradient(135deg, rgba(255,255,255,.95), rgba(244,247,255,.9)); box-shadow: 0 20px 44px -38px rgba(31,63,170,.5); }
  .roundup-insights__heading { display: flex; justify-content: space-between; gap: 18px; align-items: start; margin-bottom: 18px; }
  .roundup-insights__heading h2 { margin: 0; color: #203257; font-size: 21px; letter-spacing: -.025em; }
  .roundup-insights__heading > div > p:not(.eyebrow) { margin: 5px 0 0; color: #77859e; font-size: 12px; }
  .roundup-insights__years { display: flex; flex-wrap: wrap; justify-content: end; gap: 6px; }
  .roundup-insights__years span { border: 1px solid #dbe4ff; border-radius: 999px; padding: 4px 8px; background: #f0f4ff; color: #5570cb; font-size: 10px; font-weight: 800; }
  .roundup-insights__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 11px; }
  .roundup-card { display: flex; min-height: 200px; flex-direction: column; border: 1px solid #e7ebf4; border-radius: 14px; padding: 14px; background: rgba(255,255,255,.92); color: inherit; text-decoration: none; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .roundup-card:hover { border-color: #bccbfa; box-shadow: 0 17px 29px -25px rgba(42,77,182,.65); color: inherit; text-decoration: none; transform: translateY(-2px); }
  .roundup-card--featured { border-color: #cdd9ff; background: linear-gradient(145deg, #f4f7ff, #fff); }
  .roundup-card__meta, .roundup-card__foot { display: flex; justify-content: space-between; gap: 7px; align-items: center; color: #8895aa; font-size: 10px; }
  .roundup-card__meta span { border-radius: 99px; padding: 3px 6px; background: #eaf0ff; color: #4b67c7; font-size: 9px; font-weight: 800; }
  .roundup-card h3 { display: -webkit-box; overflow: hidden; margin: 12px 0 7px; color: #263958; font-size: 14px; line-height: 1.52; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .roundup-card p { display: -webkit-box; overflow: hidden; margin: 0; color: #74829a; font-size: 11px; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .roundup-card__foot { margin-top: auto; padding-top: 13px; border-top: 1px solid #eef1f6; }
  .roundup-card__foot b { color: #4664cb; font-size: 10px; }.roundup-card__foot i { font-size: 13px; font-style: normal; }
  @media (max-width: 1020px) { .roundup-insights__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .roundup-insights { padding: 17px; }.roundup-insights__heading { display:block; }.roundup-insights__years { justify-content:start; margin-top: 10px; }.roundup-insights__grid { grid-template-columns: 1fr; }.roundup-card { min-height: 168px; } }
</style>
